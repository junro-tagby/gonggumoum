# .env.local로 복사해서 사용합니다. 모든 값은 선택 사항입니다.

# 수집할 인포크 프로필(쉼표로 구분, 최대 10개). 비워 두면 config/sources.ts의 기본 프로필을 수집합니다.
INPOCK_HANDLES=

# 수집 요청의 User-Agent에 붙는 연락처 URL. 판매처가 운영자에게 연락할 수 있도록 운영 환경에서는 설정하세요.
# 예: https://gonggumoum.example.com/contact
CRAWLER_CONTACT_URL=

# Instagram #공구 수집(Facebook 로그인 기반 Instagram Graph API). 세 값을 모두 설정해야 동작합니다.
# 토큰은 서버에서만 쓰이며 화면이나 API 응답에 노출되지 않습니다.
INSTAGRAM_ACCESS_TOKEN=
# 연결된 Instagram 프로페셔널 계정의 숫자 ID
INSTAGRAM_USER_ID=
# 앱에서 사용하는 Graph API 버전. 예: v24.0
INSTAGRAM_GRAPH_VERSION=
